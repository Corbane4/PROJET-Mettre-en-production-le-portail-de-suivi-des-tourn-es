# Delegation Helios - equipe suivi des tournees (groupe suivi)
Cmnd_Alias SUIVI_SVC = /usr/bin/systemctl restart helios-suivi.service, \
                       /usr/bin/systemctl status --no-pager helios-suivi.service
Cmnd_Alias SUIVI_PUB = /usr/bin/systemctl start helios-suivi-publish.service
Cmnd_Alias SUIVI_LOG = /usr/bin/journalctl -u helios-suivi.service -n 100 --no-pager, \
                       /usr/bin/journalctl -u helios-suivi-publish.service -n 100 --no-pager
Defaults:%suivi timestamp_timeout=5, passwd_tries=2
%suivi ALL = (root) SUIVI_SVC, SUIVI_PUB, SUIVI_LOG
